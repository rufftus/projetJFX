<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="171.0" prefWidth="294.0" spacing="5.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetjfx.LoginController">
    <padding>
        <Insets bottom="25.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="loginText" alignment="CENTER" prefHeight="17.0" prefWidth="154.0" text="Veuillez saisir vos identifiants">
      <font>
         <Font name="System Bold" size="11.0" />
      </font>
      <VBox.margin>
         <Insets bottom="5.0" />
      </VBox.margin></Label>

    <HBox alignment="TOP_CENTER" prefHeight="25.0" prefWidth="191.0" spacing="50.0">
        <Label prefWidth="50.0" text="login   " textAlignment="JUSTIFY" />
        <TextField fx:id="loginField" alignment="CENTER">
         <HBox.margin>
            <Insets />
         </HBox.margin></TextField>
    </HBox>
   <HBox alignment="TOP_CENTER" prefHeight="25.0" prefWidth="191.0" spacing="25.0">
      <children>
         <Label alignment="CENTER" prefHeight="17.0" prefWidth="100.0" text="mot de passe  " />
         <PasswordField fx:id="passwordField" />
      </children>
   </HBox>
   <HBox alignment="TOP_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
      <children>
      
                <Button fx:id="loginButton" alignment="CENTER" onAction="#onLoginButtonClick" text="Se connecter" />
         <Button mnemonicParsing="false" onAction="#onLogoutButtonClick" text="Se déconnecter">
            <HBox.margin>
               <Insets />
            </HBox.margin>
         </Button>
      </children>
      <VBox.margin>
         <Insets />
      </VBox.margin>
   </HBox>
</VBox>
